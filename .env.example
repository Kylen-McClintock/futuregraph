# FutureGraph Environment Variables Sample
# Copy this file to .env.local and fill in your Supabase credentials

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PROJECT_REF=your-project-ref
FUTUREGRAPH_RECEIPT_SIGNING_SECRET=generate-a-32-byte-hex-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional AI Provider Credentials for Live Model Forecast Submissions
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
