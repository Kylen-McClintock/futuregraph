# FutureGraph Environment Variables Sample
# Copy this file to .env.local and fill in your Supabase credentials

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PROJECT_REF=your-project-ref
FUTUREGRAPH_RECEIPT_SIGNING_SECRET=generate-a-32-byte-hex-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Unified AGIFutures.org + FutureGraph sign-in (shared Supabase Auth) ---
# Use the SAME Supabase project on agifutures.org. Set to ".agifutures.org" in production when
# the two apps are served from different subdomains; leave empty when both share one host.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
# Comma-separated editors/admins allowed to resolve questions (emails and/or X handles).
FUTUREGRAPH_ADMIN_EMAILS=
FUTUREGRAPH_ADMIN_X_HANDLES=
# Header secret for scripted admin calls (x-futuregraph-admin-secret).
FUTUREGRAPH_ADMIN_SECRET=
# Vercel Cron bearer token for the daily oracle sync (/api/v1/oracles/sync).
CRON_SECRET=
# Optional: Metaculus API token (required by Metaculus for API access).
METACULUS_API_TOKEN=
# Local demo sign-in (no real OAuth). Defaults ON in development, OFF in production.
FUTUREGRAPH_DEMO_AUTH=
# Optional separate HMAC secret for demo session cookies (falls back to the receipt secret).
FUTUREGRAPH_SESSION_SECRET=

# Optional AI Provider Credentials for Live Model Forecast Submissions
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
